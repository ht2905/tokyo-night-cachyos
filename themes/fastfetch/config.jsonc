{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": {
      "1": "blue",
      "2": "cyan"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": " 󰅂 ",
    "color": {
      "keys": "cyan",
      "title": "blue"
    }
  },
  "modules": [
    "title",
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "os",
      "key": "OS   ",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "key": "KER  ",
      "keyColor": "cyan"
    },
    {
      "type": "uptime",
      "key": "UP   ",
      "keyColor": "green"
    },
    {
      "type": "packages",
      "key": "PKG  ",
      "keyColor": "yellow"
    },
    {
      "type": "shell",
      "key": "SH   ",
      "keyColor": "magenta"
    },
    {
      "type": "terminal",
      "key": "TERM ",
      "keyColor": "blue"
    },
    {
      "type": "cpu",
      "key": "CPU  ",
      "keyColor": "cyan"
    },
    {
      "type": "memory",
      "key": "MEM  ",
      "keyColor": "magenta"
    },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
